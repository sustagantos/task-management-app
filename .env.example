# Copy to .env on the container host, chmod 600, fill from Vaultwarden.
# Never commit the filled-in file.

DB_PASSWORD=

# Entra app registration: task-management-sso
# Directory (tenant) ID and Application (client) ID are on the Overview page.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Shown once when created. Record the expiry date - sign-in stops the day it lapses.
ENTRA_CLIENT_SECRET=
